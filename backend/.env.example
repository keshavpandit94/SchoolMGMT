PORT=5000

# MongoDB Atlas Cloud Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/school_mgmt?retryWrites=true&w=majority

JWT_SECRET=supersecretjwtkey12345!

# Brevo HTTPS Email API (Get free key at https://app.brevo.com/settings/keys/api)
# Note: Free tier sends 300 emails/day to ANY recipient email address.
# EMAIL_FROM should match your registered Brevo account email or a verified sender in Brevo.
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=contact@schoolmgmt.com

# Cloudinary Image Storage Credentials (Get free account at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CLIENT_URL=http://localhost:5173
